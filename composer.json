{
  "name": "outstand/fluentform-weoinvoice",
  "description": "Issues a WeoInvoice document when a Fluent Forms payment is paid. Works with any Fluent Forms payment method, such as ifthenpay.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Sérgio Santos",
      "homepage": "https://s3rgiosan.dev"
    }
  ],
  "autoload": {
    "psr-4": {
      "Outstand\\WP\\FluentForm\\Addons\\WeoInvoice\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Outstand\\WP\\FluentForm\\Addons\\WeoInvoice\\Tests\\Unit\\": "tests/php/unit/"
    }
  },
  "require": {
    "php": "^8.2",
    "composer-plugin-api": "^2.3",
    "yahnis-elsts/plugin-update-checker": "^5.6"
  },
  "require-dev": {
    "doctrine/instantiator": "~2.0.0",
    "phpunit/phpunit": "^9.6",
    "pixelalbatross/coding-standards": "dev-main",
    "yoast/phpunit-polyfills": "^1.1"
  },
  "scripts": {
    "lint": "phpcs .",
    "lint-fix": "phpcbf .",
    "test": "phpunit"
  },
  "extra": {
    "installer-name": "fluentform-weoinvoice"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "optimize-autoloader": true
  }
}
